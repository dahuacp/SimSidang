#ASSISTANT_RATE_PER_CONVERSATION=50
#ASSISTANT_QUERY_ENABLED=true
#ASSISTANT_QUERY_MAX_ROWS=50
#ASSISTANT_RAW_SQL_ENABLED=true

# University (untuk cetak PDF)
UNIVERSITY_NAME="UNIVERSITAS DARUL ULUM JOMBANG"
UNIVERSITY_FAKULTAS="FAKULTAS TEKNIK"
UNIVERSITY_ADDRESS="Jl. Gus Dur 29A Jombang 51413"
UNIVERSITY_PHONE="(0321) 877157"
UNIVERSITY_FAX="(0321) 877157"
UNIVERSITY_WEBSITE="http://ft.undar.ac.id"
UNIVERSITY_EMAIL="adm.ftundar@gmail.com"

# Bobot nilai rekap hasil penilaian (persen, total harus 100)
NILAI_DOSPEM_WEIGHT=50
NILAI_PENGUJI_WEIGHT=50

VITE_APP_NAME="${APP_NAME}"
